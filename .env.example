# HTTP port of the debugging UI/API.
FI_PORT=8080
# Container file ownership. Defaults suit Docker Desktop; quickstart.sh exports host IDs.
FI_CONTAINER_UID=10001
FI_CONTAINER_GID=10001
# Leave empty for the standalone UI/report viewer started by the public quick start.
# Set both to http://perception:8000 when starting the integrated GPU service.
FI_CORE_URL=
FI_PERCEPTION_URL=
FI_PERCEPTION_API_KEY=
# Leave empty for standalone mode. Use http://vlm:8000 only when starting that service.
FI_VLM_BASE_URL=
FI_VLM_MODEL=Qwen/Qwen3-VL-8B-Instruct
FI_VLM_REVISION=a115a837cf3cbba4b697aa74b609721b5009ed41
FI_VLM_API_KEY=EMPTY
# Local caches/weights; no secret values belong here and these folders stay ignored.
FI_REPORTS=./runs
FI_WEIGHTS_DIR=./weights
# runtime = CLIP jersey reader; runtime-vlm additionally compiles local llama.cpp.
FI_PERCEPTION_STAGE=runtime
# Ada=89, Blackwell=120; used only when FI_PERCEPTION_STAGE=runtime-vlm.
FI_CUDA_ARCHS=89;120
# Keep optional semantic-VLM downloads in the same external model directory.
HF_HOME=./weights/huggingface
